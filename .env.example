# Backend environment variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
WS_PORT=3001
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise

# Auth (Better-Auth)
# Generate a secret: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string-minimum
BETTER_AUTH_URL=http://localhost:3000

# API docs (Scalar) — disabled by default in production.
# Set to "true" to expose /api/docs and /api/docs-json in production.
ENABLE_API_DOCS=false

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# OAuth providers (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# reCAPTCHA / captcha (optional — leave RECAPTCHA_SECRET_KEY empty to DISABLE
# captcha protection on sign-up / sign-in. In production, if set, it MUST be a
# real provider secret (not the provider name) or the app will refuse to boot.
# RECAPTCHA_SECRET_KEY=

# SMTP / Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev
SMTP_PASS=dev
SMTP_FROM=no-reply@example.com


# S3 / File storage (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Redis
REDIS_PASSWORD=changeme-redis-password
REDIS_URL=redis://:changeme-redis-password@localhost:6379
