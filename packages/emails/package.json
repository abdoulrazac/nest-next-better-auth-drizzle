{
  "name": "@repo/emails",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "generate:theme": "bun run ./scripts/generate-email-theme.ts",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@nuntly/better-email": "^1.0.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "nodemailer": "^8.0.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
