{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "DATABASE_URL",
        "DATABASE_SSL",
        "SEED_ADMIN_EMAIL",
        "SEED_ADMIN_NAME",
        "NEXT_PUBLIC_API_URL",
        "EXPO_PUBLIC_SERVER_URL",
        "EXPO_PUBLIC_API_URL",
        "API_URL"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "generate": {
      "dependsOn": [],
      "inputs": ["openapi.json", "openapi-ts.config.ts"],
      "outputs": ["src/generated/**"],
      "env": [
        "NEXT_PUBLIC_API_URL",
        "EXPO_PUBLIC_SERVER_URL",
        "EXPO_PUBLIC_API_URL",
        "API_URL"
      ],
      "cache": true
    }
  }
}
